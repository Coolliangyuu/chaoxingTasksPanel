<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>学习通作业看板</AssemblyTitle>
    <Product>学习通作业看板</Product>
    <Version>1.5.0</Version>
    <AssemblyName>chaoxingTaskPanel</AssemblyName>
    <RootNamespace>StudyTasks</RootNamespace>
    <ApplicationIcon>StudyTasks.ico</ApplicationIcon>
    <!-- Early Windows 10 22H2 patches fail in CoreCLR CET startup before Main. -->
    <CetCompat>false</CetCompat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3595.46" />
    <EmbeddedResource Include="Login.js;Homework.js;AccountIdentity.js;AutoLogin.js;StudyTasks.ico;Toast.ps1" />
    <EmbeddedResource Include="../version-history.txt" LogicalName="StudyTasks.VersionHistory.txt" />
    <EmbeddedResource Include="../compatibility-policy.json" LogicalName="StudyTasks.CompatibilityPolicy.json" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
